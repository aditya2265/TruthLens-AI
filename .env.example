# TruthLens AI — Environment Configuration Example
# Copy this file to .env and adjust values for local development.

# Flask secret key for sessions and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Application environment (development or production)
FLASK_ENV=development

# Server port
FLASK_PORT=5000

# Feature Flags
ENABLE_LOCAL_HISTORY=true
MAX_INPUT_LENGTH=15000

# Google Fact Check Tools API Key (Stage 4)
# Obtain a key with Fact Check Tools API enabled from Google Cloud Console:
# https://developers.google.com/fact-check/tools/api/reference/rest
GOOGLE_FACTCHECK_API_KEY=
